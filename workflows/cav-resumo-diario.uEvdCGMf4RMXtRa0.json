    {
      "parameters": {
        "jsCode": "// Para onde vao os alertas. REMETENTE tem de ser a conta da credencial de email (SMTP).\nconst PARA = 'cesarfsaraujo@gmail.com';\nconst REMETENTE = 'cesarfsaraujo@gmail.com';\nconst N8N = 'https://olivedrab-cat-986392.hostingersite.com';\nconst esc = s => String(s == null ? '' : s).replace(/[&<>\"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\nconst quando = new Date().toLocaleString('pt-PT', { timeZone: 'Europe/Lisbon' });\nconst tabela = linhas => '<table style=\"border-collapse:collapse;font:14px/1.5 system-ui,sans-serif\">' + linhas.filter(l => l[1] !== undefined && l[1] !== null && l[1] !== '').map(([k, v]) =>\n  '<tr><td style=\"padding:4px 14px 4px 0;color:#666;vertical-align:top\">' + esc(k) + '</td><td style=\"padding:4px 0\">' + (String(v).startsWith('http') ? '<a href=\"' + esc(v) + '\">abrir no n8n</a>' : esc(v)) + '</td></tr>').join('') + '</table>';\n\n// Resumo do dia, a partir do Airtable. Cada mensagem nova de um comercial cria um Evento\n// (uma confirmacao \"sim\" reaproveita o da pergunta), por isso Eventos de hoje = mensagens\n// interpretadas = chamadas a IA. Dia sem actividade: nao envia nada.\nconst recs = n => { try { return $(n).first().json.records || []; } catch (e) { return []; } };\nconst ev = recs('Eventos de hoje'), leads = recs('Leads de hoje'), hist = recs('Histórico de hoje'), pend = recs('Pendências resolvidas hoje');\nif (!ev.length && !hist.length) return [];\nconst conta = (rs, campo) => rs.reduce((m, r) => { const v = (r.fields || {})[campo] || '—'; m[v] = (m[v] || 0) + 1; return m; }, {});\nconst est = conta(ev, 'Estado'), tipos = conta(hist, 'tipo_registo');\nconst falhas = (est.recebido || 0) + (est.interpretado || 0);\nconst NOMES = { contacto: 'contactos', mudanca_estagio: 'mudanças de fase', checklist_documento: 'documentos', banco_proposta: 'propostas de banco',\n  lead_nova: 'leads novas', dados_lead: 'dados corrigidos', proposta: 'propostas enviadas', nota: 'notas', estado_comercial: 'leituras do negócio' };\nconst dia = new Date().toLocaleDateString('pt-PT', { timeZone: 'Europe/Lisbon', weekday: 'long', day: 'numeric', month: 'numeric' });\nconst linhas = [\n  ['Mensagens interpretadas pela IA', ev.length],\n  ['Confirmadas e gravadas', est.comprometido || 0],\n  ['Cartões por responder', est.pendente || 0],\n  ['Corrigidas pelo comercial («não»)', est.rejeitado || 0],\n  ['Ficaram a meio (falhas)', falhas],\n  ['Leads novas', leads.length],\n  ['Pendências resolvidas', pend.length],\n  ['No histórico', Object.entries(tipos).map(([k, v]) => v + ' ' + (NOMES[k] || k)).join(', ')],\n];\nconst assunto = '📊 CAV — ' + dia + ': ' + ev.length + ' mensagens' + (falhas ? ', ' + falhas + ' com falha' : '');\nconst html = '<p style=\"font:15px system-ui,sans-serif\"><b>Resumo de ' + esc(dia) + '</b></p>' + tabela(linhas)\n  + '<p style=\"font:12px system-ui,sans-serif;color:#888\">Plano gratuito do Gemini: 20 chamadas por dia (confirmar o plano actual).</p>';\nreturn [{ json: { para: PARA, remetente: REMETENTE, assunto, html } }];\n"
      },
