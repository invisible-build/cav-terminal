      "parameters": {
        "respondWith": "text",
        "responseBody": "<!DOCTYPE html>\n<html lang=\"pt-PT\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#08090d\">\n<title>CAV — Terminal</title>\n<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23c8921a'/%3E%3Ctext x='16' y='23' font-size='19' font-family='Georgia,serif' text-anchor='middle' fill='%23000'%3EC%3C/text%3E%3C/svg%3E\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Instrument+Serif:ital@0;1&family=DM+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --bg:#08090d;--s1:#0d0e14;--s2:#12131c;--s3:#181924;\n  --border:#1f2030;--border2:#2a2b3e;\n  --gold:#c8921a;--gold2:#e6aa38;\n  --blue:#3366f0;--blue2:#5580ff;\n  --green:#16a85a;--green2:#1fc96e;\n  --red:#c42828;--red2:#e03838;\n  --orange:#c86800;--orange2:#e88020;\n  --purple:#5c48d8;--purple2:#7c68ff;\n  --text:#d4d5e2;--text2:#84859a;--text3:#42435a;\n  --sans:'Plus Jakarta Sans',system-ui,sans-serif;\n  --serif:'Instrument Serif',Georgia,serif;\n  --mono:'DM Mono',ui-monospace,monospace;\n  --safe-b:env(safe-area-inset-bottom,0px);\n}\n*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}\nhtml{font-size:14px;-webkit-font-smoothing:antialiased;-webkit-tap-highlight-color:transparent}\nbody{background:var(--bg);color:var(--text);font-family:var(--sans);min-height:100dvh;display:flex;flex-direction:column;overflow:hidden}\nbutton,input,select,textarea{font-family:inherit;font-size:inherit;color:inherit}\nbutton{cursor:pointer;border:none;background:none}\n::-webkit-scrollbar{width:8px;height:8px}\n::-webkit-scrollbar-thumb{background:var(--border2);border-radius:4px}\n\n/* ---------- TOPBAR ---------- */\n.topbar{height:54px;background:var(--s1);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 14px;gap:10px;flex-shrink:0}\n.logo-mark{width:30px;height:30px;background:var(--gold);border-radius:8px;display:grid;place-items:center;font-family:var(--serif);font-size:15px;color:#000;flex-shrink:0}\n.logo-name{font-family:var(--serif);font-size:16px;font-style:italic;white-space:nowrap}\n.tb-right{display:flex;align-items:center;gap:8px;margin-left:auto}\n.who{display:flex;align-items:center;gap:7px;background:var(--s2);border:1px solid var(--border);border-radius:100px;padding:4px 10px 4px 5px;font-size:12px;font-weight:600}\n.who .av{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;font-size:10px;font-weight:800;color:#000}\n.icon-btn{width:32px;height:32px;border-radius:8px;background:var(--s2);border:1px solid var(--border);display:grid;place-items:center;color:var(--text2);font-size:14px}\n.icon-btn:hover{color:var(--text);border-color:var(--border2)}\n.dot{width:6px;height:6px;border-radius:50%;background:var(--green2);flex-shrink:0}\n.dot.off{background:var(--red2)}\n.dot.busy{background:var(--gold2);animation:pulse 1.2s infinite}\n@keyframes pulse{0%,100%{opacity:1}50%{opacity:.25}}\n\n/* ---------- NAV ---------- */\n.tabs{display:flex;gap:2px;background:var(--s1);border-bottom:1px solid var(--border);padding:0 10px;flex-shrink:0;overflow-x:auto;scrollbar-width:none}\n.tabs::-webkit-scrollbar{display:none}\n.tab{padding:11px 13px;font-size:12px;font-weight:700;color:var(--text3);border-bottom:2px solid transparent;white-space:nowrap;letter-spacing:.2px}\n.tab.on{color:var(--gold2);border-bottom-color:var(--gold)}\n.tab .n{font-family:var(--mono);font-size:10px;background:var(--s3);padding:1px 5px;border-radius:100px;margin-left:5px;color:var(--text2)}\n\n/* ---------- LAYOUT ---------- */\nmain{flex:1;overflow:hidden;position:relative}\n.view{display:none;height:100%;overflow-y:auto;padding:16px 14px 150px}\n.view.on{display:block}\n.wrap{max-width:1180px;margin:0 auto}\n.sec-h{display:flex;align-items:center;gap:9px;margin:20px 0 10px}\n.sec-h:first-child{margin-top:0}\n.sec-h h2{font-size:11px;font-weight:800;letter-spacing:1.1px;text-transform:uppercase;color:var(--text2)}\n.sec-h .line{flex:1;height:1px;background:var(--border)}\n.sec-h .cnt{font-family:var(--mono);font-size:10px;color:var(--text3)}\n\n/* ---------- CARDS ---------- */\n.card{background:var(--s1);border:1px solid var(--border);border-radius:13px;padding:13px}\n.card+.card{margin-top:9px}\n.grid{display:grid;gap:9px}\n@media(min-width:760px){.grid.c2{grid-template-columns:1fr 1fr}.grid.c3{grid-template-columns:repeat(3,1fr)}\n.col-b{min-height:220px}}\n\n.lead-row{display:flex;align-items:center;gap:11px;background:var(--s1);border:1px solid var(--border);border-radius:12px;padding:11px 13px;width:100%;text-align:left;transition:border-color .15s}\n.lead-row:hover{border-color:var(--border2)}\n.lead-row+.lead-row{margin-top:7px}\n.av-sq{width:34px;height:34px;border-radius:9px;display:grid;place-items:center;font-weight:800;font-size:12px;color:#000;flex-shrink:0}\n.lr-main{flex:1;min-width:0;display:block}\n.lr-name{display:block;font-size:13px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.lr-sub{display:block;font-size:11px;color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}\n.lr-right{text-align:right;flex-shrink:0}\n.val{font-family:var(--mono);font-size:12px;font-weight:500;color:var(--gold2)}\n\n.chip{display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:700;padding:2px 8px;border-radius:100px;background:var(--s3);color:var(--text2);white-space:nowrap}\n.chip.g{background:rgba(22,168,90,.14);color:var(--green2)}\n.chip.r{background:rgba(196,40,40,.14);color:var(--red2)}\n.chip.o{background:rgba(200,104,0,.16);color:var(--orange2)}\n.chip.b{background:rgba(51,102,240,.14);color:var(--blue2)}\n.chip.y{background:rgba(200,146,26,.15);color:var(--gold2)}\n\n.empty{text-align:center;padding:34px 18px;color:var(--text3);font-size:12px}\n.empty .big{font-size:26px;margin-bottom:9px;opacity:.5}\n\n/* ---------- PIPELINE ---------- */\n.board{display:flex;gap:12px;overflow-x:auto;padding-bottom:10px;align-items:flex-start}\n.col{flex-shrink:0;width:250px}\n.col-h{display:flex;align-items:center;gap:7px;padding:0 3px 8px}\n.col-h .d{width:8px;height:8px;border-radius:50%;flex-shrink:0}\n.col-h .t{font-size:10.5px;font-weight:800;text-transform:uppercase;letter-spacing:.6px;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis}\n.col-h .n{font-family:var(--mono);font-size:10px;color:var(--text3)}\n.col-b{background:var(--s1);border:1px solid var(--border);border-radius:12px;padding:8px;min-height:120px;display:flex;flex-direction:column;gap:7px}\n.mini{background:var(--s2);border:1px solid var(--border);border-radius:9px;padding:9px 10px;text-align:left;width:100%}\n.mini:hover{border-color:var(--border2)}\n.mini .n{font-size:12px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.mini .m{display:flex;align-items:center;gap:6px;margin-top:5px;font-size:10px;color:var(--text2)}\n\n/* ---------- TASK ---------- */\n.task{display:flex;gap:10px;align-items:flex-start;background:var(--s1);border:1px solid var(--border);border-radius:12px;padding:11px 12px}\n.task+.task{margin-top:7px}\n.task.urg{border-left:2px solid var(--red)}\n.task .bx{width:19px;height:19px;border-radius:6px;border:1.5px solid var(--border2);flex-shrink:0;margin-top:1px;display:grid;place-items:center;font-size:11px;color:transparent}\n.task .bx.done{background:var(--green);border-color:var(--green);color:#fff}\n.task .tx{flex:1;font-size:12.5px;line-height:1.45}\n.task.is-done .tx{text-decoration:line-through;color:var(--text3)}\n\n/* ---------- MIC DOCK ---------- */\n.dock{position:fixed;left:0;right:0;bottom:0;padding:12px 14px calc(12px + var(--safe-b));background:linear-gradient(to top,var(--bg) 62%,transparent);display:flex;justify-content:center;pointer-events:none;z-index:40}\n.dock-in{width:100%;max-width:620px;pointer-events:auto}\n.mic-bar{display:flex;align-items:center;gap:9px;background:var(--s2);border:1px solid var(--border2);border-radius:100px;padding:7px 7px 7px 16px;box-shadow:0 10px 34px rgba(0,0,0,.6)}\n.mic-txt{flex:1;background:none;border:none;outline:none;font-size:13px;min-width:0}\n.mic-txt::placeholder{color:var(--text3)}\n.mic-btn{width:42px;height:42px;border-radius:50%;background:var(--gold);color:#000;display:grid;place-items:center;font-size:17px;flex-shrink:0;transition:transform .12s}\n.mic-btn:active{transform:scale(.93)}\n.mic-btn.rec{background:var(--red2);color:#fff;animation:rec 1.1s infinite}\n@keyframes rec{0%,100%{box-shadow:0 0 0 0 rgba(224,56,56,.55)}70%{box-shadow:0 0 0 13px rgba(224,56,56,0)}}\n.mic-btn.busy{background:var(--s3);color:var(--gold2)}\n.hint{text-align:center;font-size:10.5px;color:var(--text3);margin-top:7px;height:14px}\n\n/* ---------- SHEET (confirmação) ---------- */\n.scrim{position:fixed;inset:0;background:rgba(4,5,8,.72);backdrop-filter:blur(3px);z-index:50;display:none}\n.scrim.on{display:block}\n.sheet{position:fixed;left:0;right:0;bottom:0;z-index:60;background:var(--s1);border-top:1px solid var(--border2);border-radius:20px 20px 0 0;padding:20px 18px calc(20px + var(--safe-b));transform:translateY(102%);transition:transform .26s cubic-bezier(.32,.72,0,1);max-height:86dvh;overflow-y:auto}\n.sheet.on{transform:translateY(0)}\n@media(min-width:700px){.sheet{left:50%;right:auto;bottom:22px;width:520px;transform:translate(-50%,140%);border-radius:18px;border:1px solid var(--border2)}.sheet.on{transform:translate(-50%,0)}}\n.sheet .grab{width:36px;height:4px;background:var(--border2);border-radius:2px;margin:-8px auto 15px}\n.sheet h3{font-family:var(--serif);font-size:20px;font-style:italic;line-height:1.32;margin-bottom:6px}\n.said{font-size:11.5px;color:var(--text2);font-style:italic;border-left:2px solid var(--border2);padding-left:10px;margin:12px 0}\n.opts{display:flex;flex-direction:column;gap:8px;margin-top:16px}\n.opt{padding:13px 15px;border-radius:11px;background:var(--s2);border:1px solid var(--border);font-size:13px;font-weight:600;text-align:left;transition:all .14s}\n.opt:hover{border-color:var(--border2)}\n.opt.yes{background:var(--gold);color:#000;border-color:var(--gold);font-weight:700}\n.opt.no{color:var(--text2)}\n.ev-list{margin-top:14px;display:flex;flex-direction:column;gap:6px}\n.ev{display:flex;gap:8px;align-items:flex-start;font-size:11.5px;color:var(--text2);background:var(--s2);border-radius:9px;padding:8px 10px}\n.ev .k{font-family:var(--mono);font-size:9.5px;color:var(--gold2);background:rgba(200,146,26,.12);padding:1px 6px;border-radius:100px;flex-shrink:0;margin-top:1px}\n\n/* ---------- LEAD PANEL ---------- */\n.panel{position:fixed;top:0;right:0;bottom:0;width:min(430px,100%);background:var(--s1);border-left:1px solid var(--border);z-index:70;transform:translateX(102%);transition:transform .26s cubic-bezier(.32,.72,0,1);display:flex;flex-direction:column}\n.panel.on{transform:translateX(0)}\n.p-head{padding:16px 16px 13px;border-bottom:1px solid var(--border);display:flex;gap:12px;align-items:flex-start;flex-shrink:0}\n.p-body{flex:1;overflow-y:auto;padding:16px}\n.p-close{margin-left:auto;width:30px;height:30px;border-radius:8px;background:var(--s2);color:var(--text2);display:grid;place-items:center;flex-shrink:0}\n.kv{display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px solid var(--border);font-size:12px}\n.kv .k{color:var(--text2)}\n.kv .v{font-weight:600;text-align:right}\n.tl{position:relative;padding-left:16px;margin-top:4px}\n.tl::before{content:'';position:absolute;left:4px;top:5px;bottom:5px;width:1px;background:var(--border)}\n.tl-i{position:relative;padding:0 0 13px}\n.tl-i::before{content:'';position:absolute;left:-15px;top:5px;width:7px;height:7px;border-radius:50%;background:var(--border2);border:2px solid var(--s1)}\n.tl-i .d{font-family:var(--mono);font-size:9.5px;color:var(--text3);text-transform:uppercase;letter-spacing:.4px}\n.tl-i .t{font-size:12px;line-height:1.5;margin-top:3px}\n\n/* ---------- MODAL ---------- */\n.modal{position:fixed;inset:0;z-index:80;display:none;place-items:center;padding:18px;background:rgba(4,5,8,.75)}\n.modal.on{display:grid}\n.modal-in{background:var(--s1);border:1px solid var(--border2);border-radius:16px;padding:20px;width:100%;max-width:430px;max-height:86dvh;overflow-y:auto}\n.modal h3{font-family:var(--serif);font-size:19px;font-style:italic;margin-bottom:14px}\n.fld{margin-bottom:12px}\n.fld label{display:block;font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--text2);margin-bottom:5px}\n.fld input,.fld select,.fld textarea{width:100%;background:var(--s2);border:1px solid var(--border);border-radius:9px;padding:10px 11px;outline:none;font-size:13px}\n.fld input:focus,.fld select:focus,.fld textarea:focus{border-color:var(--gold)}\n.fld .help{font-size:10.5px;color:var(--text3);margin-top:5px;line-height:1.45}\n.m-act{display:flex;gap:8px;margin-top:16px}\n.m-act button{flex:1;padding:11px;border-radius:10px;font-size:13px;font-weight:700}\n.m-act .cancel{background:var(--s2);border:1px solid var(--border);color:var(--text2)}\n.m-act .ok{background:var(--gold);color:#000}\n\n/* ---------- TOAST ---------- */\n.toast{position:fixed;left:50%;bottom:96px;transform:translate(-50%,26px);z-index:90;background:var(--s3);border:1px solid var(--border2);border-radius:11px;padding:11px 16px;font-size:12.5px;font-weight:600;opacity:0;transition:all .22s;pointer-events:none;max-width:90vw;text-align:center;box-shadow:0 8px 30px rgba(0,0,0,.5)}\n.toast.on{opacity:1;transform:translate(-50%,0)}\n.toast.err{border-color:var(--red);color:var(--red2)}\n.toast.ok{border-color:var(--green);color:var(--green2)}\n\n/* ---------- LOGIN ---------- */\n.login{position:fixed;inset:0;z-index:100;background:var(--bg);display:grid;place-items:center;padding:22px}\n.login-in{width:100%;max-width:340px;text-align:center}\n.login .mk{width:56px;height:56px;background:var(--gold);border-radius:15px;display:grid;place-items:center;font-family:var(--serif);font-size:26px;color:#000;margin:0 auto 16px}\n.login h1{font-family:var(--serif);font-size:26px;font-style:italic;margin-bottom:5px}\n.login p{font-size:12px;color:var(--text2);margin-bottom:24px}\n.who-list{display:flex;flex-direction:column;gap:8px}\n.who-btn{display:flex;align-items:center;gap:11px;padding:13px 15px;border-radius:12px;background:var(--s1);border:1px solid var(--border);text-align:left}\n.who-btn:hover{border-color:var(--gold)}\n.who-btn .av{width:32px;height:32px;border-radius:9px;display:grid;place-items:center;font-weight:800;font-size:12px;color:#000;flex-shrink:0}\n.who-btn .nm{font-size:13.5px;font-weight:700}\n.who-btn .rl{font-size:11px;color:var(--text2)}\n.spin{width:17px;height:17px;border:2px solid var(--border2);border-top-color:var(--gold);border-radius:50%;animation:sp .7s linear infinite;display:inline-block}\n@keyframes sp{to{transform:rotate(360deg)}}\n</style>\n</head>\n<body>\n\n<!-- ====================== LOGIN ====================== -->\n<div class=\"login\" id=\"login\">\n  <div class=\"login-in\">\n    <div class=\"mk\">C</div>\n    <h1>CAV</h1>\n    <p id=\"loginSub\">a ligar ao sistema…</p>\n    <div class=\"who-list\" id=\"whoList\"></div>\n    <button class=\"opt\" style=\"margin-top:18px;text-align:center\" onclick=\"openCfg()\">⚙ Definições de ligação</button>\n  </div>\n</div>\n\n<!-- ====================== TOPBAR ====================== -->\n<div class=\"topbar\">\n  <div class=\"logo-mark\">C</div>\n  <div class=\"logo-name\">CAV</div>\n  <div class=\"tb-right\">\n    <span class=\"dot\" id=\"netDot\" title=\"ligação\"></span>\n    <button class=\"icon-btn\" onclick=\"refresh(true)\" title=\"Actualizar\">⟳</button>\n    <button class=\"icon-btn\" onclick=\"openCfg()\" title=\"Definições\">⚙</button>\n    <button class=\"who\" id=\"whoChip\" onclick=\"logout()\"></button>\n  </div>\n</div>\n\n<!-- ====================== TABS ====================== -->\n<div class=\"tabs\" id=\"tabs\"></div>\n\n<!-- ====================== VIEWS ====================== -->\n<main>\n  <section class=\"view on\" id=\"v-hoje\"><div class=\"wrap\" id=\"c-hoje\"></div></section>\n  <section class=\"view\" id=\"v-pipe\"><div class=\"wrap\" id=\"c-pipe\"></div></section>\n  <section class=\"view\" id=\"v-tarefas\"><div class=\"wrap\" id=\"c-tarefas\"></div></section>\n  <section class=\"view\" id=\"v-agenda\"><div class=\"wrap\" id=\"c-agenda\"></div></section>\n  <section class=\"view\" id=\"v-equipa\"><div class=\"wrap\" id=\"c-equipa\"></div></section>\n</main>\n\n<!-- ====================== MIC DOCK ====================== -->\n<div class=\"dock\">\n  <div class=\"dock-in\">\n    <div class=\"mic-bar\">\n      <input class=\"mic-txt\" id=\"micTxt\" placeholder=\"Fala ou escreve o que aconteceu…\"\n             onkeydown=\"if(event.key==='Enter')enviar()\">\n      <button class=\"mic-btn\" id=\"micBtn\" onclick=\"micTap()\">🎙</button>\n    </div>\n    <div class=\"hint\" id=\"hint\"></div>\n  </div>\n</div>\n\n<!-- ====================== SHEET CONFIRMAÇÃO ====================== -->\n<div class=\"scrim\" id=\"scrim\" onclick=\"fecharSheet()\"></div>\n<div class=\"sheet\" id=\"sheet\">\n  <div class=\"grab\"></div>\n  <h3 id=\"shQ\"></h3>\n  <div class=\"said\" id=\"shSaid\"></div>\n  <div class=\"ev-list\" id=\"shEvs\"></div>\n  <div class=\"opts\" id=\"shOpts\"></div>\n</div>\n\n<!-- ====================== PAINEL LEAD ====================== -->\n<div class=\"panel\" id=\"panel\">\n  <div class=\"p-head\">\n    <div class=\"av-sq\" id=\"plAv\"></div>\n    <div style=\"flex:1;min-width:0\">\n      <div style=\"font-size:15px;font-weight:700\" id=\"plNome\"></div>\n      <div style=\"font-size:11.5px;color:var(--text2);margin-top:2px\" id=\"plSub\"></div>\n    </div>\n    <button class=\"p-close\" onclick=\"fecharPainel()\">✕</button>\n  </div>\n  <div class=\"p-body\" id=\"plBody\"></div>\n</div>\n\n<!-- ====================== MODAL DEFINIÇÕES ====================== -->\n<div class=\"modal\" id=\"mCfg\">\n  <div class=\"modal-in\">\n    <h3>Ligação ao n8n</h3>\n    <div class=\"fld\">\n      <label>URL base do n8n</label>\n      <input id=\"cfgBase\" placeholder=\"https://o-teu-n8n.com\">\n      <div class=\"help\">Sem barra no fim. É onde correm os workflows.</div>\n    </div>\n    <div class=\"fld\">\n      <label>Caminho — entrada de voz</label>\n      <input id=\"cfgIn\" placeholder=\"cav-inbound\">\n    </div>\n    <div class=\"fld\">\n      <label>Caminho — leitura de dados</label>\n      <input id=\"cfgDados\" placeholder=\"cav-dados\">\n    </div>\n    <div class=\"fld\">\n      <label>Chave da app (opcional)</label>\n      <input id=\"cfgKey\" placeholder=\"deixa vazio se não usares\">\n      <div class=\"help\">Enviada no cabeçalho <span style=\"font-family:var(--mono)\">x-cav-key</span>. Serve para o n8n recusar pedidos de fora.</div>\n    </div>\n    <div class=\"m-act\">\n      <button class=\"cancel\" onclick=\"closeM('mCfg')\">Fechar</button>\n      <button class=\"ok\" onclick=\"saveCfg()\">Guardar</button>\n    </div>\n  </div>\n</div>\n\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\n/* ============================================================\n   CAV — Terminal do comercial\n   Fala → n8n (Secretária) → confirmação → Committer → Airtable\n   ============================================================ */\n\n/* ---------- 1. CONFIGURAÇÃO ---------- */\nconst CFG_KEY='cav-cfg';\nconst CFG_DEF={\n  base:'https://olivedrab-cat-986392.hostingersite.com',\n  inbound:'cav-inbound',\n  dados:'cav-dados',\n  key:''\n};\nlet CFG={...CFG_DEF};\ntry{const s=localStorage.getItem(CFG_KEY); if(s)CFG={...CFG_DEF,...JSON.parse(s)};}catch(e){}\nconst url=p=>CFG.base.replace(/\\/+$/,'')+'/webhook/'+p.replace(/^\\/+/,'');\nconst headers=()=>{const h={'Content-Type':'application/json'}; if(CFG.key)h['x-cav-key']=CFG.key; return h;};\n\n/* ---------- 2. HELPERS ---------- */\nconst $=id=>document.getElementById(id);\nconst esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst eur=v=>v?Number(v).toLocaleString('pt-PT')+' €':'—';\nconst CORES=['#c8921a','#3366f0','#9b59b6','#16a85a','#c86800','#5c48d8','#0e9080'];\nconst corDe=s=>CORES[[...String(s||'')].reduce((a,c)=>a+c.charCodeAt(0),0)%CORES.length];\nconst iniciais=n=>String(n||'?').trim().split(/\\s+/).slice(0,2).map(w=>w[0]||'').join('').toUpperCase();\nconst hoje0=()=>{const d=new Date();d.setHours(0,0,0,0);return d;};\nfunction dias(iso){ if(!iso)return null; const d=new Date(iso); if(isNaN(d))return null;\n  return Math.round((hoje0()-new Date(d.getFullYear(),d.getMonth(),d.getDate()))/864e5); }\nfunction dataCurta(iso){ if(!iso)return '—'; const d=new Date(iso); if(isNaN(d))return String(iso);\n  return d.toLocaleDateString('pt-PT',{day:'2-digit',month:'short'}); }\nfunction dataHora(iso){ if(!iso)return '—'; const d=new Date(iso); if(isNaN(d))return String(iso);\n  return d.toLocaleDateString('pt-PT',{day:'2-digit',month:'short'})+' '+d.toLocaleTimeString('pt-PT',{hour:'2-digit',minute:'2-digit'}); }\nfunction quandoRel(iso){ const n=dias(iso); if(n===null)return '';\n  if(n===0)return 'hoje'; if(n===1)return 'ontem'; if(n===-1)return 'amanhã';\n  return n>0? ('há '+n+' dias') : ('em '+(-n)+' dias'); }\n\nlet toastT=null;\nfunction toast(msg,tipo){ const t=$('toast'); t.textContent=msg; t.className='toast on'+(tipo?' '+tipo:'');\n  clearTimeout(toastT); toastT=setTimeout(()=>t.className='toast',3200); }\n\n/* ---------- 3. ESTADO ---------- */\nlet S={comerciais:[],leads:[],tarefas:[],agenda:[],pendencias:[],historico:[],estagios:[]};\nlet EU=null;                 // comercial autenticado\nlet TAB='hoje';\nlet PEND=null;               // bilhete à espera de confirmação\nlet OCUPADO=false;\nlet LEAD_ABERTA=null;\n\nconst ESTAGIOS_FALLBACK=['lead','aguarda_documentos','aguarda_decisao_banco','aprovado',\n  'proposta_enviada','aguarda_banco','escritura_marcada','fecho'];\nconst NOME_ESTAGIO={lead:'Lead',aguarda_documentos:'Documentos',aguarda_decisao_banco:'Decisão banco',\n  aprovado:'Aprovado',proposta_enviada:'Proposta enviada',aguarda_banco:'Aguarda banco',\n  escritura_marcada:'Escritura',fecho:'Fecho',nutricao:'Nutrição'};\nconst rotulo=e=>NOME_ESTAGIO[e]||e||'—';\n\n/* ---------- 4. API ---------- */\nasync function apiDados(){\n  const r=await fetch(url(CFG.dados),{method:'POST',headers:headers(),\n    body:JSON.stringify({comercial_id:EU?EU.id:null})});\n  if(!r.ok) throw new Error('Leitura falhou ('+r.status+')');\n  return await r.json();\n}\nasync function apiFalar(payload){\n  const r=await fetch(url(CFG.inbound),{method:'POST',headers:headers(),body:JSON.stringify(payload)});\n  const txt=await r.text();\n  let j=null; try{ j=JSON.parse(txt); }catch(e){}\n  if(!r.ok) throw new Error((j&&(j.message||j.erro))||('Erro '+r.status+': '+txt.slice(0,140)));\n  return j||{};\n}\n\nfunction net(estado){ const d=$('netDot'); d.className='dot'+(estado==='off'?' off':estado==='busy'?' busy':''); }\n\nasync function refresh(aviso){\n  try{\n    net('busy');\n    const d=await apiDados();\n    S.comerciais=d.comerciais||[]; S.leads=d.leads||[]; S.tarefas=d.tarefas||[];\n    S.agenda=d.agenda||[]; S.pendencias=d.pendencias||[]; S.historico=d.historico||[];\n    S.estagios=(d.config&&d.config.estagios&&d.config.estagios.length)?d.config.estagios:ESTAGIOS_FALLBACK;\n    net('on'); render();\n    if(aviso) toast('Actualizado','ok');\n    return true;\n  }catch(e){ net('off'); if(aviso) toast(e.message,'err'); return false; }\n}\n\n/* ---------- 5. VOZ ----------\n   Estratégia: transcrever no browser (rápido, grátis).\n   Se não houver suporte ou falhar, grava áudio e manda para o Whisper no n8n. */\nconst SR=window.SpeechRecognition||window.webkitSpeechRecognition;\nlet rec=null, gravador=null, pedacos=[], aGravar=false, modoAudio=false;\n\nfunction micEstado(e){\n  const b=$('micBtn');\n  b.className='mic-btn'+(e==='rec'?' rec':e==='busy'?' busy':'');\n  b.textContent = e==='rec'?'■' : e==='busy'?'…' : '🎙';\n}\nfunction hint(t){ $('hint').textContent=t||''; }\n\nfunction micTap(){\n  if(OCUPADO) return;\n  if(aGravar){ pararVoz(); return; }\n  const t=$('micTxt').value.trim();\n  if(t){ enviar(); return; }\n  iniciarVoz();\n}\n\nfunction iniciarVoz(){\n  if(SR){\n    try{\n      rec=new SR(); rec.lang='pt-PT'; rec.continuous=true; rec.interimResults=true;\n      let final='';\n      rec.onresult=ev=>{\n        let interim='';\n        for(let i=ev.resultIndex;i<ev.results.length;i++){\n          const r=ev.results[i];\n          if(r.isFinal) final+=r[0].transcript+' '; else interim+=r[0].transcript;\n        }\n        $('micTxt').value=(final+interim).trim();\n      };\n      rec.onerror=ev=>{\n        if(ev.error==='not-allowed'||ev.error==='service-not-allowed'){\n          aGravar=false; micEstado(''); hint('Sem permissão para o microfone.'); return;\n        }\n        gravarAudio();               // fallback\n      };\n      rec.onend=()=>{ if(aGravar&&!modoAudio){ aGravar=false; micEstado(''); hint('');\n        if($('micTxt').value.trim()) enviar(); } };\n      rec.start(); aGravar=true; modoAudio=false; micEstado('rec');\n      hint('A ouvir… toca no ■ para terminar');\n      return;\n    }catch(e){ /* cai para áudio */ }\n  }\n  gravarAudio();\n}\n\nasync function gravarAudio(){\n  try{\n    const stream=await navigator.mediaDevices.getUserMedia({audio:true});\n    const mime=['audio/webm;codecs=opus','audio/webm','audio/mp4'].find(m=>window.MediaRecorder&&MediaRecorder.isTypeSupported(m))||'';\n    gravador=mime?new MediaRecorder(stream,{mimeType:mime}):new MediaRecorder(stream);\n    pedacos=[];\n    gravador.ondataavailable=e=>{ if(e.data.size) pedacos.push(e.data); };\n    gravador.onstop=async()=>{\n      stream.getTracks().forEach(t=>t.stop());\n      const blob=new Blob(pedacos,{type:gravador.mimeType||'audio/webm'});\n      if(blob.size<900){ micEstado(''); hint('Não apanhei nada.'); return; }\n      const b64=await new Promise(res=>{const fr=new FileReader();\n        fr.onloadend=()=>res(String(fr.result).split(',')[1]);fr.readAsDataURL(blob);});\n      enviar({audio_base64:b64,audio_mime:(gravador.mimeType||'audio/webm').split(';')[0]});\n    };\n    gravador.start(); aGravar=true; modoAudio=true; micEstado('rec');\n    hint('A gravar… toca no ■ para enviar');\n  }catch(e){\n    aGravar=false; micEstado(''); hint('Sem acesso ao microfone — escreve na caixa.');\n  }\n}\n\nfunction pararVoz(){\n  aGravar=false;\n  if(modoAudio&&gravador&&gravador.state!=='inactive'){ micEstado('busy'); hint('A transcrever…'); gravador.stop(); return; }\n  if(rec){ try{rec.stop();}catch(e){} }\n  micEstado(''); hint('');\n}\n\n/* ---------- 6. ENVIAR / CONFIRMAR ---------- */\nasync function enviar(extra){\n  if(OCUPADO) return;\n  const texto=$('micTxt').value.trim();\n  if(!texto && !(extra&&extra.audio_base64)){ toast('Diz ou escreve alguma coisa.'); return; }\n  OCUPADO=true; micEstado('busy'); hint('A interpretar…'); net('busy');\n  try{\n    const r=await apiFalar({comercial_id:EU.id, texto: texto||undefined, ...(extra||{})});\n    $('micTxt').value='';\n    tratarResposta(r);\n  }catch(e){ toast(e.message,'err'); net('off'); }\n  finally{ OCUPADO=false; micEstado(''); hint(''); }\n}\n\nasync function responder(valor){\n  if(!PEND||OCUPADO) return;\n  OCUPADO=true;\n  const opts=$('shOpts'); opts.innerHTML='<div style=\"text-align:center;padding:12px\"><span class=\"spin\"></span></div>';\n  try{\n    const r=await apiFalar({comercial_id:EU.id, evento_pendente_id:PEND.evento_id,\n      evento_pendente:{dominante:PEND.dominante||null,\n                       transcricao_original:PEND.transcricao||'',\n                       eventos:PEND.eventos||[]},\n      resposta:valor});\n    tratarResposta(r);\n  }catch(e){ toast(e.message,'err'); fecharSheet(); }\n  finally{ OCUPADO=false; }\n}\n\nfunction tratarResposta(r){\n  net('on');\n  const estado=r.estado||r.status;\n  if(estado==='pergunta'){ PEND=r; abrirSheet(r); return; }\n  fecharSheet();\n  if(estado==='comprometido'){ toast(r.resumo||'Registado ✓','ok'); refresh(); return; }\n  if(estado==='sem_accao'){ toast('Não havia nada para registar.'); return; }\n  if(estado==='rejeitado'){ toast('Descartado.'); refresh(); return; }\n  toast(r.mensagem||'Feito','ok'); refresh();\n}\n\nfunction abrirSheet(r){\n  $('shQ').textContent=r.pergunta||'Confirmas?';\n  $('shSaid').textContent=r.transcricao?('“'+r.transcricao+'”'):'';\n  $('shSaid').style.display=r.transcricao?'block':'none';\n  const evs=Array.isArray(r.eventos)?r.eventos:[];\n  $('shEvs').innerHTML=evs.map(e=>{\n    const desc=e.nota_ficheiro||(e.dados&&(e.dados.descricao||e.dados.tarefa||e.dados.titulo||e.dados.resumo||e.dados.estagio_destino))||e.tipo;\n    return '<div class=\"ev\"><span class=\"k\">'+esc(e.tipo||'?')+'</span><span>'+esc(desc)+'</span></div>';\n  }).join('');\n  let opts=Array.isArray(r.opcoes)&&r.opcoes.length?r.opcoes:[{valor:'sim',etiqueta:'Sim, é isso'},{valor:'nao',etiqueta:'Não'}];\n  $('shOpts').innerHTML=opts.map((o,i)=>{\n    const v=esc(o.valor), cls=(o.valor==='sim'||i===0)?'opt yes':(o.valor==='nao'?'opt no':'opt');\n    return '<button class=\"'+cls+'\" onclick=\"responder(\\''+v.replace(/'/g,\"\\\\'\")+'\\')\">'+esc(o.etiqueta||o.valor)+'</button>';\n  }).join('')+'<button class=\"opt no\" onclick=\"fecharSheet()\">Agora não</button>';\n  $('scrim').classList.add('on'); $('sheet').classList.add('on');\n}\nfunction fecharSheet(){ PEND=null; $('scrim').classList.remove('on'); $('sheet').classList.remove('on'); }\n\n/* ---------- 7. RENDER ---------- */\nconst meusLeads=()=>S.leads.filter(l=>!EU||!l.comercial_id||l.comercial_id===EU.id);\nconst ativos=()=>meusLeads().filter(l=>l.estagio!=='nutricao'&&l.status!=='saida');\nconst minhasTarefas=()=>S.tarefas.filter(t=>{const l=S.leads.find(x=>x.id===t.lead_id);return !EU||!l||!l.comercial_id||l.comercial_id===EU.id;});\nconst leadDe=id=>S.leads.find(l=>l.id===id);\nconst nomeLead=id=>{const l=leadDe(id);return l?l.nome:'—';};\n\nconst TABS=[\n  {id:'hoje',   n:'Hoje',    cnt:()=>minhasTarefas().filter(t=>t.estado!=='feita').length},\n  {id:'pipe',   n:'Pipeline',cnt:()=>ativos().length},\n  {id:'tarefas',n:'Tarefas', cnt:()=>minhasTarefas().filter(t=>t.estado!=='feita').length},\n  {id:'agenda', n:'Agenda',  cnt:()=>S.agenda.filter(a=>a.estado!=='cancelado').length},\n  {id:'equipa', n:'Equipa',  cnt:()=>S.comerciais.length},\n];\nfunction setTab(id){ TAB=id;\n  document.querySelectorAll('.view').forEach(v=>v.classList.remove('on'));\n  $('v-'+id).classList.add('on'); render();\n}\nfunction renderTabs(){\n  $('tabs').innerHTML=TABS.map(t=>'<button class=\"tab'+(TAB===t.id?' on':'')+'\" onclick=\"setTab(\\''+t.id+'\\')\">'\n    +t.n+'<span class=\"n\">'+t.cnt()+'</span></button>').join('');\n}\n\nfunction render(){\n  if(!EU) return;\n  $('whoChip').innerHTML='<span class=\"av\" style=\"background:'+corDe(EU.nome)+'\">'+esc(iniciais(EU.nome))+'</span>'+esc(EU.nome.split(' ')[0]);\n  renderTabs();\n  ({hoje:rHoje,pipe:rPipe,tarefas:rTarefas,agenda:rAgenda,equipa:rEquipa}[TAB]||rHoje)();\n}\n\nfunction secH(titulo,cnt){ return '<div class=\"sec-h\"><h2>'+esc(titulo)+'</h2><div class=\"line\"></div>'\n  +(cnt!==undefined?'<span class=\"cnt\">'+cnt+'</span>':'')+'</div>'; }\nfunction vazio(icone,txt){ return '<div class=\"empty\"><div class=\"big\">'+icone+'</div>'+esc(txt)+'</div>'; }\n\nfunction linhaLead(l){\n  const d=dias(l.ultimo_contacto);\n  const alerta=d!==null&&d>=10;\n  return '<button class=\"lead-row\" onclick=\"abrirLead(\\''+l.id+'\\')\">'\n    +'<span class=\"av-sq\" style=\"background:'+corDe(l.nome)+'\">'+esc(iniciais(l.nome))+'</span>'\n    +'<span class=\"lr-main\"><span class=\"lr-name\">'+esc(l.nome)+'</span>'\n    +'<span class=\"lr-sub\">'+esc(rotulo(l.estagio))+(d!==null?' · '+(d===0?'hoje':'há '+d+'d'):'')+'</span></span>'\n    +'<span class=\"lr-right\">'+(l.valor?'<div class=\"val\">'+eur(l.valor)+'</div>':'')\n    +(alerta?'<span class=\"chip r\">parado</span>':'')+'</span></button>';\n}\n\nfunction rHoje(){\n  const t=minhasTarefas().filter(x=>x.estado!=='feita');\n  const atras=t.filter(x=>x.prazo&&dias(x.prazo)>0);\n  const hj=t.filter(x=>x.prazo&&dias(x.prazo)===0);\n  const ag=S.agenda.filter(a=>a.estado!=='cancelado'&&a.quando&&dias(a.quando)<=0&&dias(a.quando)>=-7)\n    .sort((a,b)=>new Date(a.quando)-new Date(b.quando));\n  const pend=S.pendencias.filter(p=>p.estado==='aberta');\n  const parados=ativos().filter(l=>{const d=dias(l.ultimo_contacto);return d!==null&&d>=10;})\n    .sort((a,b)=>dias(b.ultimo_contacto)-dias(a.ultimo_contacto));\n  let h='';\n  h+=secH('Em atraso',atras.length)+(atras.length?atras.map(cardTarefa).join(''):vazio('✓','Nada em atraso.'));\n  if(hj.length) h+=secH('Para hoje',hj.length)+hj.map(cardTarefa).join('');\n  h+=secH('Próximos encontros',ag.length)+(ag.length?ag.map(cardAgenda).join(''):vazio('📅','Sem nada marcado.'));\n  h+=secH('À espera de terceiros',pend.length)+(pend.length?pend.map(cardPend).join(''):vazio('⏳','Nada pendente.'));\n  h+=secH('Parados há mais de 10 dias',parados.length)+(parados.length?parados.slice(0,8).map(linhaLead).join(''):vazio('👍','Tudo em movimento.'));\n  $('c-hoje').innerHTML=h;\n}\n\nfunction cardTarefa(t){\n  const atras=t.prazo&&dias(t.prazo)>0;\n  return '<div class=\"task'+(atras?' urg':'')+(t.estado==='feita'?' is-done':'')+'\">'\n    +'<span class=\"bx'+(t.estado==='feita'?' done':'')+'\">✓</span>'\n    +'<span class=\"tx\">'+esc(t.tarefa||'')\n    +'<div style=\"margin-top:5px;display:flex;gap:6px;flex-wrap:wrap\">'\n    +(t.lead_id?'<span class=\"chip b\">'+esc(nomeLead(t.lead_id))+'</span>':'')\n    +(t.prazo?'<span class=\"chip'+(atras?' r':'')+'\">'+dataCurta(t.prazo)+' · '+quandoRel(t.prazo)+'</span>':'')\n    +(t.follow_up_auto?'<span class=\"chip y\">follow-up auto</span>':'')\n    +'</div></span></div>';\n}\nfunction cardAgenda(a){\n  return '<div class=\"task\"><span class=\"bx\" style=\"border:none;font-size:15px;color:var(--gold2)\">📅</span>'\n    +'<span class=\"tx\">'+esc(a.titulo||'')\n    +'<div style=\"margin-top:5px;display:flex;gap:6px;flex-wrap:wrap\">'\n    +(a.lead_id?'<span class=\"chip b\">'+esc(nomeLead(a.lead_id))+'</span>':'')\n    +'<span class=\"chip y\">'+dataHora(a.quando)+'</span>'\n    +(a.estado?'<span class=\"chip\">'+esc(a.estado)+'</span>':'')\n    +'</div></span></div>';\n}\nfunction cardPend(p){\n  const atras=p.data_prometida&&dias(p.data_prometida)>0;\n  return '<div class=\"task'+(atras?' urg':'')+'\"><span class=\"bx\" style=\"border:none;font-size:14px;color:var(--orange2)\">⏳</span>'\n    +'<span class=\"tx\">'+esc(p.descricao||'')\n    +'<div style=\"margin-top:5px;display:flex;gap:6px;flex-wrap:wrap\">'\n    +(p.lead_id?'<span class=\"chip b\">'+esc(nomeLead(p.lead_id))+'</span>':'')\n    +(p.depende_de?'<span class=\"chip o\">'+esc(p.depende_de)+'</span>':'')\n    +(p.data_prometida?'<span class=\"chip'+(atras?' r':'')+'\">'+dataCurta(p.data_prometida)+'</span>':'')\n    +'</div></span></div>';\n}\n\nfunction rPipe(){\n  const ls=ativos(), est=S.estagios.length?S.estagios:ESTAGIOS_FALLBACK;\n  const total=ls.reduce((s,l)=>s+(Number(l.valor)||0),0);\n  let h=secH('Pipeline · '+ls.length+' leads · '+eur(total));\n  h+='<div class=\"board\">'+est.map((e,i)=>{\n    const col=ls.filter(l=>l.estagio===e);\n    return '<div class=\"col\"><div class=\"col-h\"><span class=\"d\" style=\"background:'+CORES[i%CORES.length]+'\"></span>'\n      +'<span class=\"t\">'+esc(rotulo(e))+'</span><span class=\"n\">'+col.length+'</span></div>'\n      +'<div class=\"col-b\">'+(col.length?col.map(l=>{\n        const d=dias(l.ultimo_contacto);\n        return '<button class=\"mini\" onclick=\"abrirLead(\\''+l.id+'\\')\"><div class=\"n\">'+esc(l.nome)+'</div>'\n          +'<div class=\"m\">'+(l.valor?'<span class=\"val\" style=\"font-size:10px\">'+eur(l.valor)+'</span>':'')\n          +(d!==null?'<span>'+(d===0?'hoje':'há '+d+'d')+'</span>':'')+'</div></button>';\n      }).join(''):'<div style=\"text-align:center;color:var(--text3);font-size:11px;padding:12px\">vazio</div>')\n      +'</div></div>';\n  }).join('')+'</div>';\n  $('c-pipe').innerHTML=h;\n}\n\nfunction rTarefas(){\n  const t=minhasTarefas(), abertas=t.filter(x=>x.estado!=='feita'), feitas=t.filter(x=>x.estado==='feita');\n  let h=secH('Abertas',abertas.length)+(abertas.length?abertas.map(cardTarefa).join(''):vazio('✓','Sem tarefas abertas.'));\n  if(feitas.length) h+=secH('Concluídas',feitas.length)+feitas.slice(0,20).map(cardTarefa).join('');\n  $('c-tarefas').innerHTML=h;\n}\nfunction rAgenda(){\n  const a=S.agenda.filter(x=>x.estado!=='cancelado').sort((x,y)=>new Date(x.quando)-new Date(y.quando));\n  const fut=a.filter(x=>dias(x.quando)<=0), pas=a.filter(x=>dias(x.quando)>0);\n  let h=secH('Por vir',fut.length)+(fut.length?fut.map(cardAgenda).join(''):vazio('📅','Nada marcado.'));\n  if(pas.length) h+=secH('Passados',pas.length)+pas.slice(0,15).map(cardAgenda).join('');\n  $('c-agenda').innerHTML=h;\n}\nfunction rEquipa(){\n  let h=secH('Comerciais',S.comerciais.length);\n  h+='<div class=\"grid c2\">'+S.comerciais.map(c=>{\n    const ls=S.leads.filter(l=>l.comercial_id===c.id&&l.estagio!=='nutricao');\n    const val=ls.reduce((s,l)=>s+(Number(l.valor)||0),0);\n    return '<div class=\"card\"><div style=\"display:flex;align-items:center;gap:10px\">'\n      +'<span class=\"av-sq\" style=\"background:'+corDe(c.nome)+'\">'+esc(iniciais(c.nome))+'</span>'\n      +'<div style=\"flex:1;min-width:0\"><div style=\"font-weight:700;font-size:13px\">'+esc(c.nome)+'</div>'\n      +'<div style=\"font-size:11px;color:var(--text2)\">'+ls.length+' leads · '+eur(val)+'</div></div>'\n      +(c.ativo===false?'<span class=\"chip r\">inativo</span>':'<span class=\"chip g\">ativo</span>')\n      +'</div></div>';\n  }).join('')+'</div>';\n  $('c-equipa').innerHTML=h;\n}\n\n/* ---------- 8. PAINEL DA LEAD ---------- */\nfunction abrirLead(id){\n  const l=leadDe(id); if(!l) return;\n  LEAD_ABERTA=id;\n  $('plAv').style.background=corDe(l.nome);\n  $('plAv').textContent=iniciais(l.nome);\n  $('plNome').textContent=l.nome;\n  $('plSub').textContent=rotulo(l.estagio)+(l.telefone?' · '+l.telefone:'');\n\n  const hist=S.historico.filter(h=>h.lead_id===id)\n    .sort((a,b)=>new Date(b.data||0)-new Date(a.data||0));\n  const tar=S.tarefas.filter(t=>t.lead_id===id&&t.estado!=='feita');\n  const pen=S.pendencias.filter(p=>p.lead_id===id&&p.estado==='aberta');\n  const ag =S.agenda.filter(a=>a.lead_id===id&&a.estado!=='cancelado');\n\n  let h='';\n  h+='<div class=\"card\">'\n    +kv('Estágio',rotulo(l.estagio))\n    +kv('Valor',eur(l.valor))\n    +kv('Telefone',l.telefone||'—')\n    +kv('Origem',l.origem_lead||'—')\n    +kv('Tipo',l.tipo||'—')\n    +kv('Último contacto',l.ultimo_contacto?(dataCurta(l.ultimo_contacto)+' · '+quandoRel(l.ultimo_contacto)):'—')\n    +'</div>';\n  if(l.ultima_nota) h+='<div class=\"card\" style=\"margin-top:9px\"><div style=\"font-size:10.5px;font-weight:800;text-transform:uppercase;letter-spacing:.7px;color:var(--text2);margin-bottom:6px\">Última nota</div><div style=\"font-size:12.5px;line-height:1.5\">'+esc(l.ultima_nota)+'</div></div>';\n  if(tar.length) h+=secH('Tarefas',tar.length)+tar.map(cardTarefa).join('');\n  if(pen.length) h+=secH('Pendências',pen.length)+pen.map(cardPend).join('');\n  if(ag.length)  h+=secH('Agenda',ag.length)+ag.map(cardAgenda).join('');\n  h+=secH('Histórico',hist.length);\n  h+=hist.length? '<div class=\"tl\">'+hist.map(x=>'<div class=\"tl-i\"><div class=\"d\">'\n      +esc(dataCurta(x.data))+(x.tipo_registo?' · '+esc(x.tipo_registo):'')+'</div>'\n      +'<div class=\"t\">'+esc(x.nota||x.registo||'')+'</div></div>').join('')+'</div>'\n    : vazio('📄','Sem histórico.');\n  $('plBody').innerHTML=h;\n  $('panel').classList.add('on'); $('scrim').classList.add('on');\n}\nfunction kv(k,v){ return '<div class=\"kv\"><span class=\"k\">'+esc(k)+'</span><span class=\"v\">'+esc(v)+'</span></div>'; }\nfunction fecharPainel(){ LEAD_ABERTA=null; $('panel').classList.remove('on');\n  if(!PEND) $('scrim').classList.remove('on'); }\n\n/* ---------- 9. DEFINIÇÕES ---------- */\nfunction openM(id){ $(id).classList.add('on'); }\nfunction closeM(id){ $(id).classList.remove('on'); }\nfunction openCfg(){\n  $('cfgBase').value=CFG.base; $('cfgIn').value=CFG.inbound;\n  $('cfgDados').value=CFG.dados; $('cfgKey').value=CFG.key||'';\n  openM('mCfg');\n}\nfunction saveCfg(){\n  CFG={base:$('cfgBase').value.trim()||CFG_DEF.base,\n       inbound:$('cfgIn').value.trim()||CFG_DEF.inbound,\n       dados:$('cfgDados').value.trim()||CFG_DEF.dados,\n       key:$('cfgKey').value.trim()};\n  try{localStorage.setItem(CFG_KEY,JSON.stringify(CFG));}catch(e){}\n  closeM('mCfg'); toast('Guardado','ok'); arrancar();\n}\n\n/* ---------- 10. AUTENTICAÇÃO (escolha de comercial) ---------- */\nconst EU_KEY='cav-eu';\nfunction escolher(id){\n  const c=S.comerciais.find(x=>x.id===id); if(!c) return;\n  EU=c; try{localStorage.setItem(EU_KEY,id);}catch(e){}\n  $('login').style.display='none';\n  refresh();\n}\nfunction logout(){\n  EU=null; try{localStorage.removeItem(EU_KEY);}catch(e){}\n  $('login').style.display='grid'; arrancar();\n}\nfunction pintarLogin(){\n  $('loginSub').textContent=S.comerciais.length?'Quem está a usar?':'Sem comerciais para mostrar.';\n  $('whoList').innerHTML=S.comerciais.map(c=>\n    '<button class=\"who-btn\" onclick=\"escolher(\\''+c.id+'\\')\">'\n    +'<span class=\"av\" style=\"background:'+corDe(c.nome)+'\">'+esc(iniciais(c.nome))+'</span>'\n    +'<span><span class=\"nm\">'+esc(c.nome)+'</span><br><span class=\"rl\">'+esc(c.email||'comercial')+'</span></span>'\n    +'</button>').join('');\n}\n\n/* ---------- 11. ARRANQUE ---------- */\nasync function arrancar(){\n  $('loginSub').innerHTML='<span class=\"spin\"></span>';\n  $('whoList').innerHTML='';\n  const ok=await refresh();\n  if(!ok){\n    $('loginSub').textContent='Não consegui falar com o n8n. Confirma as definições.';\n    return;\n  }\n  let guardado=null; try{guardado=localStorage.getItem(EU_KEY);}catch(e){}\n  const c=guardado&&S.comerciais.find(x=>x.id===guardado);\n  if(c){ EU=c; $('login').style.display='none'; render(); }\n  else { pintarLogin(); }\n}\n\ndocument.addEventListener('keydown',e=>{\n  if(e.key==='Escape'){ fecharSheet(); fecharPainel(); closeM('mCfg'); }\n});\narrancar();\n</script>\n</body>\n</html>\n",
